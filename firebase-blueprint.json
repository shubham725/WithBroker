        "submitterMobile",
        "submitterWhatsapp",
        "submitterRole",
        "workflowStatus",
        "submittedAt",
        "updatedAt"
      ]
    },
    "RoommateListing": {
      "title": "RoommateListing",
      "description": "Private master roommate listing record containing submitter contact PII and userId ownership. Readable/editable only by the listing owner (uid) or sole admin.",
      "type": "object",
      "properties": {
        "listingCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "pattern": "^WB-RM-[0-9]{4,8}$"
        },
        "userId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "listingType": { "type": "string", "enum": ["have_room", "need_room"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "contactNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "whatsappNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "gender": { "type": "string", "enum": ["Male", "Female", "Prefer not to say"] },
        "age": { "type": "number" },
        "occupation": { "type": "string", "enum": ["Working Professional", "Student", "Other"] },
        "roomType": {
          "type": "string",
          "enum": [
            "1RK",
            "1BHK",
            "2BHK",
            "3BHK",
            "Independent Room",
            "Shared Room",
            "Hall / Living Room Space",
            "1BHK Sharing",
            "2BHK Sharing",
            "3BHK Sharing",
            "Other"
          ]
        },
        "flatOccupancy": {
          "type": "string",
          "enum": ["Pre-Occupied Flat", "New Flat"]
        },
        "electricityBill": { "type": "string", "maxLength": 80 },
        "facilities": { "type": "array" },
        "urgent": { "type": "boolean" },
        "shiftingNow": { "type": "boolean" },
        "secondaryContact": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "location": { "type": "string", "minLength": 2, "maxLength": 160 },
        "localitySlug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9-]+$"
        },
        "buildingName": { "type": "string", "maxLength": 160 },
        "showExactAddress": { "type": "boolean" },
        "showPublicContact": { "type": "boolean" },
        "rent": { "type": "number" },
        "deposit": { "type": "number" },
        "brokerage": { "type": "number" },
        "furnishing": { "type": "string", "enum": ["Furnished", "Semi-Furnished", "Unfurnished"] },
        "availableFrom": { "type": "string", "minLength": 4, "maxLength": 40 },
        "existingRoommates": { "type": "number" },
        "peopleRequired": { "type": "number" },
        "preferredGender": { "type": "string", "enum": ["Male", "Female", "Any"] },
        "preferredOccupation": {
          "type": "string",
          "enum": ["Working Professional", "Student", "Any"]
        },
        "preferredAgeRange": { "type": "string", "maxLength": 40 },
        "foodPreference": { "type": "string", "maxLength": 60 },
        "smokingPreference": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "images": { "type": "array" },
        "status": {
          "type": "string",
          "enum": ["Pending", "Active", "Rejected", "Fulfilled", "Unavailable"]
        },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "reportCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "listingCode",
        "userId",
        "listingType",
        "name",
        "contactNumber",
        "whatsappNumber",
        "gender",
        "occupation",
        "roomType",
        "location",
        "localitySlug",
        "showExactAddress",
        "showPublicContact",
        "rent",
        "deposit",
        "brokerage",
        "furnishing",
        "availableFrom",
        "existingRoommates",
        "peopleRequired",
        "preferredGender",
        "preferredOccupation",
        "description",
        "images",
        "status",
        "reportCount",
        "createdAt",
        "updatedAt",
        "expiresAt"
      ]
    },
