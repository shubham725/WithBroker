        "submitterMobile": {
          "type": "string",
          "minLength": 10,
          "maxLength": 15,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "submitterWhatsapp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 15,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "submitterRole": { "type": "string", "enum": ["Owner", "Broker"] },
        "workflowStatus": {
          "type": "string",
