        "listingType": { "type": "string", "enum": ["have_room", "need_room"] },
        "posterFirstName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "gender": { "type": "string", "enum": ["Male", "Female", "Prefer not to say"] },
