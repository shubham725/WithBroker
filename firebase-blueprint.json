        },
        "rent": { "type": "number" },
        "deposit": { "type": "number" },
        "brokerage": { "type": "number" },
        "furnishing": { "type": "string", "enum": ["Furnished", "Semi-Furnished", "Unfurnished"] },
        "availableFrom": { "type": "string", "minLength": 4, "maxLength": 40 },
        "existingRoommates": { "type": "number" },
        "peopleRequired": { "type": "number" },
        "preferredGender": { "type": "string", "enum": ["Male", "Female", "Any"] },
        "preferredOccupation": {
          "type": "string",
          "enum": ["Working Professional", "Student", "Any"]
        },
        "preferredAgeRange": { "type": "string", "maxLength": 40 },
        "foodPreference": { "type": "string", "maxLength": 60 },
        "smokingPreference": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "images": { "type": "array" },
        "status": { "type": "string", "enum": ["Active"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "listingCode",
        "userId",
        "listingType",
        "posterFirstName",
        "gender",
        "occupation",
        "roomType",
        "location",
        "localitySlug",
        "showExactAddress",
        "showPublicContact",
        "rent",
        "deposit",
        "brokerage",
        "furnishing",
        "availableFrom",
        "existingRoommates",
        "peopleRequired",
        "preferredGender",
        "preferredOccupation",
        "description",
        "images",
        "status",
        "createdAt",
        "updatedAt",
        "expiresAt"
      ]
    },
    "RoommateReport": {
      "title": "RoommateReport",
      "description": "User safety report flagged against a roommate listing for sole admin moderation.",
      "type": "object",
      "properties": {
        "listingCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "pattern": "^WB-RM-[0-9]{4,8}$"
        },
        "reason": { "type": "string", "minLength": 3, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 600 },
        "reporterUid": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["open", "reviewed", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listingCode", "reason", "status", "createdAt"]
    },
    "PropertyPhoto": {
      "title": "PropertyPhoto",
      "description": "Compressed rental flat or roommate room photo stored in its own document (strictly under 450KB). Private while Pending/Rejected; publicly readable only when Admin marks isPublic=true.",
      "type": "object",
      "properties": {
        "propertyCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^WB-(RM-)?[0-9]{4,8}$"
        },
        "filename": { "type": "string", "minLength": 1, "maxLength": 140 },
        "mimeType": {
          "type": "string",
          "enum": ["image/jpeg", "image/png", "image/webp"]
        },
        "dataUrl": { "type": "string", "minLength": 30, "maxLength": 450000 },
        "isPublic": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["propertyCode", "filename", "mimeType", "dataUrl", "isPublic", "createdAt"]
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "Admin dashboard notification feed for property & roommate submissions, reports, and status changes.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "submission",
            "approved",
            "rejected",
            "rented",
            "available",
            "deleted",
            "roommate_submission",
            "roommate_report",
            "roommate_fulfilled"
          ]
        },
        "propertyCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^WB-(RM-)?[0-9]{4,8}$"
        },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "message": { "type": "string", "minLength": 5, "maxLength": 400 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "propertyCode", "title", "message", "isRead", "createdAt"]
    },
    "AppMetadata": {
      "title": "AppMetadata",
      "description": "System metadata document tracking initial catalog seed state.",
      "type": "object",
      "properties": {
        "seeded": { "type": "boolean" },
        "seededAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seeded", "seededAt"]
    }
  },
  "firestore": {
    "/public_properties/{propertyId}": {
      "schema": { "$ref": "#/entities/PublicProperty" },
      "description": "Publicly readable approved rental listings (Available and Rented only, zero private contact PII)."
    },
    "/property_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/PropertySubmission" },
      "description": "All property submissions with private owner/broker contact info. Public create-only (Pending only); sole admin read/write."
    },
    "/roommate_listings/{listingId}": {
      "schema": { "$ref": "#/entities/RoommateListing" },
      "description": "Master roommate listings with owner uid and contact PII. Strict owner-only or sole-admin read/write; zero self-approval."
    },
    "/public_roommates/{listingId}": {
      "schema": { "$ref": "#/entities/PublicRoommateListing" },
      "description": "Publicly readable approved active roommate listings (PII isolated unless explicitly opted in). Sole admin publishes; owner can edit active fields or remove."
    },
    "/roommate_reports/{reportId}": {
      "schema": { "$ref": "#/entities/RoommateReport" },
      "description": "Safety reports submitted on roommate listings. Public create-only (open status); sole admin read/update/delete."
    },
    "/property_photos/{photoId}": {
      "schema": { "$ref": "#/entities/PropertyPhoto" },
      "description": "Compressed uploaded property & roommate images. Public create-only with isPublic=false; public get only when isPublic=true; sole admin full access."
    },
    "/admin_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AdminNotification" },
      "description": "Notifications for sole admin. Public create-only for unread submission/report alerts; sole admin full read/update/delete."
    },
    "/app_meta/{metaId}": {
      "schema": { "$ref": "#/entities/AppMetadata" },
      "description": "Metadata tracking whether initial Pune listings have been seeded into Firestore. Readable publicly; writable only by sole admin."
    }
  }
}
