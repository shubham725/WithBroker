{
  "functions": {
    "api/property.ts": {
      "includeFiles": "{dist/index.html,firebase-applet-config.json}"
    },
    "api/roommate.ts": {
      "includeFiles": "{dist/index.html,firebase-applet-config.json}"
    },
    "api/property-image.ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/admin/ai-property-chat.ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/property-image/:photoId",
      "destination": "/api/property-image?photoId=:photoId"
    },
    {
      "source": "/property/:id",
      "destination": "/api/property?id=:id"
    },
    {
      "source": "/roommate/:id",
      "destination": "/api/roommate?id=:id"
    },
    {
      "source": "/roommates/:id",
      "destination": "/api/roommate?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
